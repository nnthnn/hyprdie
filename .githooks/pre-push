#!/usr/bin/env bash
# Fast verification before code leaves the machine: the formatting and lint
# checks from CI's `lint` job, run locally so a broken push never reaches a PR.
# Tests and the release build rerun remotely on push/PR, so they stay out of
# the critical path here. Installed via `./install-hooks.sh`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

cargo fmt --all --check
cargo clippy --all-targets --locked -- -D warnings
